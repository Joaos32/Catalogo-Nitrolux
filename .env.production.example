# Backend production environment example.
# Copy the values into your hosting provider/SAM parameters, not into Git.

CATALOG_ENABLE_API_DOCS=false
CATALOG_ALLOW_OPEN_ADMIN=false
CATALOG_CORS_ALLOW_ORIGINS=https://catalogo.example.com,https://painel.example.com
CATALOG_CORS_ALLOW_CREDENTIALS=true
# Host interno autorizado a servir /auth/* e /catalog/erp/*.
CATALOG_ADMIN_HOSTS=painel.example.com
# O catalogo exige login de representante com JWT.
CATALOG_REQUIRE_REPRESENTATIVE_LOGIN=true

# Chave exclusiva para integrações servidor a servidor que consultam produtos.
CATALOG_INTEGRATION_API_KEY=replace-with-a-random-api-key-minimum-32-characters

# Generate unique secrets with at least 32 characters.
CATALOG_SESSION_SECRET=replace-with-a-long-random-secret-minimum-32-chars
CATALOG_REPRESENTATIVE_JWT_SECRET=replace-with-a-different-long-random-secret
CATALOG_SESSION_COOKIE_SECURE=true
CATALOG_SESSION_MAX_AGE_SECONDS=300

# Admin access. Prefer hashed users in reports/admin_users.json for local deployments,
# or configure a password in the secret manager/runtime environment.
CATALOG_ADMIN_LOGIN_EMAIL=admin@example.com
CATALOG_ADMIN_LOGIN_PASSWORD=replace-with-admin-password

# Representative access. Prefer managed representatives through the admin panel.
CATALOG_REPRESENTATIVE_JWT_EXPIRES_MINUTES=720
CATALOG_REPRESENTATIVE_IDLE_TIMEOUT_MINUTES=5

# ERP/catalog data.
CATALOG_ERP_STRICT_MODE=true
CATALOG_ERP_AUTO_DISCOVERY=false
CATALOG_ERP_MAX_UPLOAD_BYTES=10485760

# Legacy S3 media (optional).
CATALOG_S3_MEDIA_BUCKET=your-catalog-media-bucket
CATALOG_S3_MEDIA_PREFIX=produtos/
CATALOG_S3_MEDIA_PRESIGNED_URLS=false

# Fotos no Google Drive (opcao gratuita recomendada).
# Compartilhe a pasta como "qualquer pessoa com o link" e habilite a Drive API.
CATALOG_GOOGLE_DRIVE_FOLDER_ID=
CATALOG_GOOGLE_DRIVE_API_KEY=
CATALOG_GOOGLE_DRIVE_RECURSIVE=true
CATALOG_GOOGLE_DRIVE_MAX_DEPTH=4

# Vercel Blob opcional; mantenha desativado para nao gerar custo de armazenamento.
CATALOG_MEDIA_BLOB_ENABLED=false
CATALOG_MEDIA_BLOB_PREFIX=catalogo/media/

# CDN de fotos (CloudFront + S3 privado)
CATALOG_MEDIA_CDN_BASE_URL=https://example.cloudfront.net
CATALOG_MEDIA_MANIFEST_PATH=reports/media_manifest.json

# Cadastro persistente de representantes em objeto S3 privado
CATALOG_REPRESENTATIVE_S3_BUCKET=your-private-registry-bucket
CATALOG_REPRESENTATIVE_S3_KEY=private/representative_users.json
CATALOG_REPRESENTATIVE_S3_REGION=sa-east-1
CATALOG_REPRESENTATIVE_S3_ACCESS_KEY_ID=
CATALOG_REPRESENTATIVE_S3_SECRET_ACCESS_KEY=
# Preferido no Vercel: role OIDC temporaria, sem chaves permanentes
CATALOG_REPRESENTATIVE_S3_ROLE_ARN=arn:aws:iam::123456789012:role/catalogo-registry
